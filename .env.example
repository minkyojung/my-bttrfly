# --- 커스텀 글쓰기 UI (/write) ---
# 1인 소유자용 공유 비밀번호. 로그인 폼에서 이 값과 비교한다.
#
# 20자 이상이어야 한다 — 짧으면 로그인이 명시적으로 실패한다. 비밀번호 관리자로
# 생성하거나 `openssl rand -base64 24`를 쓸 것. 로그인 엔드포인트에는 시도 제한이
# 없으므로(서버리스에서 인스턴스별 카운터는 무의미하다) 온라인 추측을 비현실적으로
# 만드는 실질 통제는 이 길이뿐이다. 유출되면 content/posts 와
# public/images/uploads 에 대한 커밋 권한이 7일간 넘어간다(git revert로 되돌릴 수
# 있지만 그동안 사이트는 훼손된 상태로 배포된다).
WRITE_PASSWORD=

# 세션 쿠키 서명용 랜덤 시크릿. 충분히 긴 무작위 문자열로 설정할 것
# (예: `openssl rand -hex 32`).
WRITE_SESSION_SECRET=

# minkyojung/my-bttrfly repo에 한정된 GitHub fine-grained PAT.
# 권한: Contents = Read and write. Keystatic의 OAuth 토큰과는 별개다.
GITHUB_WRITE_TOKEN=

# /write의 저장이 커밋할 브랜치. 비워두면 main(프로덕션이 배포하는 브랜치).
# 기능 브랜치에서 작업할 때는 그 브랜치명을 넣어야 한다 — 그러지 않으면 화면에는
# 체크아웃한 브랜치의 글이 보이는데 저장은 main으로 가서, 브랜치에서 만든 글은
# 404가 나고 고친 글은 409(다른 곳에서 수정됨)가 난다.
GITHUB_WRITE_BRANCH=

# --- GitHub 잔디(contributions) 위젯 (about 페이지, lib/github.ts) ---
# 읽기 전용. 위 GITHUB_WRITE_TOKEN과는 무관하며 없어도 사이트는 정상 동작한다
# (위젯만 조용히 비활성화됨).
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Keystatic 어드민 (/keystatic, GitHub OAuth 모드) ---
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
