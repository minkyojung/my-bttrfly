# --- 커스텀 글쓰기 UI (/write) ---
# 1인 소유자용 공유 비밀번호. 로그인 폼에서 이 값과 비교한다.
WRITE_PASSWORD=

# 세션 쿠키 서명용 랜덤 시크릿. 충분히 긴 무작위 문자열로 설정할 것
# (예: `openssl rand -hex 32`).
WRITE_SESSION_SECRET=

# minkyojung/my-bttrfly repo에 한정된 GitHub fine-grained PAT.
# 권한: Contents = Read and write. Keystatic의 OAuth 토큰과는 별개다.
GITHUB_WRITE_TOKEN=

# --- GitHub 잔디(contributions) 위젯 (about 페이지, lib/github.ts) ---
# 읽기 전용. 위 GITHUB_WRITE_TOKEN과는 무관하며 없어도 사이트는 정상 동작한다
# (위젯만 조용히 비활성화됨).
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Keystatic 어드민 (/keystatic, GitHub OAuth 모드) ---
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
